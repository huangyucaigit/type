# Use either these names or the existing DATAAGENT_DEEPSEEK_LLM_API_KEY / API_URL.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com

# Optional public deployment; local defaults keep listening on 127.0.0.1.
# ZIJIAN_HOST=0.0.0.0
# ZIJIAN_PUBLIC_ORIGINS=http://47.106.182.159,http://type.where.work,https://type.where.work

# Private SQLite account/trial data, persisted separately from source files.
# ZIJIAN_AUTH_DATA_DIR=.data

# SMS login configuration; carrier registration must complete before release.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_SIGN_NAME=长沙松鼠信息火星叔叔
ALIYUN_SMS_LOGIN_TEMPLATE_CODE=SMS_172825132
ALIYUN_SMS_REGISTER_TEMPLATE_CODE=SMS_172825130

# Password-reset and email-binding sender (Amazon SES). Private credentials only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
SES_FROM_EMAIL=

# Payments are disabled by default. Mock checkout is allowed only on loopback.
ZIJIAN_PAYMENT_MODE=disabled
# Live requests also require this explicit switch. Keep 0 during mock acceptance.
ZIJIAN_ENABLE_REAL_PAYMENTS=0
PAY_BASE_URL=https://pay.where.work
PAY_PROJECT_CODE=
PAY_API_KEY_ID=
PAY_API_SECRET_BASE64=
PAY_NOTIFY_KEY_ID=
PAY_NOTIFY_SECRET_BASE64=
PAY_NOTIFY_URL=https://type.where.work/payments/notify
# Optional object mapping notification key IDs to Base64 secrets for rotation.
PAY_NOTIFY_KEYS_JSON=
